# ════════════════════════════════════════════════════════════════════
# Career Wave backend — copy to .env. Everything here stays server-side.
# ════════════════════════════════════════════════════════════════════

PORT=8080
NODE_ENV=development
# Comma-separated list of allowed frontend origins ("*" only for local dev)
CORS_ORIGINS=http://localhost:5173
DATA_DIR=data
MAX_UPLOAD_MB=10

# ── Auth0 (must match the frontend's VITE_AUTH0_DOMAIN / VITE_AUTH0_AUDIENCE) ──
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.careerwave.com/
# Local development / automated tests ONLY — accepts every request as a dev user
AUTH_DISABLED=false

# ── AI provider ──────────────────────────────────────────────────────
# agentrouter = ACTIVE (testing) | openrouter = original provider | mock = offline test data
AI_PROVIDER=agentrouter

AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=claude-opus-4.8
AGENTROUTER_BASE_URL=https://agentrouter.org
# anthropic → POST /v1/messages | openai → POST /v1/chat/completions
AGENTROUTER_API_STYLE=anthropic
# Optional JSON of extra headers, if your AgentRouter account needs them
# AGENTROUTER_EXTRA_HEADERS={"User-Agent":"career-wave/2.0"}

# Original provider (kept; switch with AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-6-luna

AI_TIMEOUT_MS=180000
AI_MAX_TOKENS=8000
LOG_LLM_RESPONSES=true
DEFAULT_PHONE_COUNTRY=IN

# ── Job web-parsing (web-parsing/scrape_india_jobs.py) ───────────────
PYTHON_BIN=python3
SCRAPER_ENABLED=true
SCRAPE_ON_STARTUP=true
SCRAPE_INTERVAL_HOURS=48
DEFAULT_SEARCH_TERM=software engineer
DEFAULT_JOB_LOCATION=India

# ── Notifications (web-parsing/notification-service) ─────────────────
# Leave NOTIFICATION_SERVICE_URL empty to let this backend start the
# notification-service itself on 127.0.0.1:NOTIFICATION_SERVICE_PORT.
NOTIFICATION_SERVICE_URL=
MANAGE_NOTIFICATION_SERVICE=true
NOTIFICATION_SERVICE_PORT=8001
ALERT_SCHEDULER_ENABLED=true
ALERT_SCHEDULER_INTERVAL_MINUTES=30
JOBS_PER_ALERT=5
# Shown to users so they can start a chat with your bot before linking
TELEGRAM_BOT_USERNAME=

# Read by the Python notification-service (inherits this environment)
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
