# ── AI provider (server-side only — never put these keys in the frontend) ──
# agentrouter = ACTIVE default for testing | openrouter = original provider | mock = offline tests
AI_PROVIDER=agentrouter

# AgentRouter — get a key at https://agentrouter.org/console/token
AGENTROUTER_API_KEY=your-agentrouter-api-key-here
AGENTROUTER_MODEL=claude-opus-4.8
AGENTROUTER_BASE_URL=https://agentrouter.org
# anthropic → POST /v1/messages   |   openai → POST /v1/chat/completions
AGENTROUTER_API_STYLE=anthropic
# Optional JSON object of extra headers if your AgentRouter account requires them
# AGENTROUTER_EXTRA_HEADERS={"User-Agent":"career-wave/1.0"}

# OpenRouter API Configuration (original provider — switch with AI_PROVIDER=openrouter)
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=openai/gpt-6-luna

# Server Configuration
PORT=3000
NODE_ENV=production

# Default region for normalising phone numbers without a country code
DEFAULT_PHONE_COUNTRY=IN

# Optional: Logging level (debug, info, warn, error)
# LOG_LEVEL=info
