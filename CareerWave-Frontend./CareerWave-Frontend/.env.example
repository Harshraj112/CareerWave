# Auth0 — must match the backend's AUTH0_DOMAIN / AUTH0_AUDIENCE
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.careerwave.com/

# Career Wave backend (the unified backend in /backend)
VITE_API_URL=http://localhost:8080

# Local development / automated tests ONLY: skip Auth0 (backend needs AUTH_DISABLED=true too)
VITE_AUTH_DISABLED=false

# Run the whole UI on local sample data with no backend (clearly labelled "Sample data")
VITE_DEMO_MODE=false

# NOTE: never put AI keys (AgentRouter / OpenRouter) here — anything prefixed VITE_ is public.
